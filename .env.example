# StableFlow API base URL (default: https://api.stableflow.ai)
VITE_BASE_API_URL=

# Rhea CrossChainDex Bearer token (required)
VITE_RHEA_CCD_API_ACCESS_TOKEN=
# Rhea CrossChainDex Bearer token for test env (required)
VITE_RHEA_CCD_API_ACCESS_TOKEN_TEST=

# WalletConnect / RainbowKit project ID (required)
VITE_RAINBOW_PROJECT_ID=

# RPC proxy host (default: rpcs.stableflow.ai)
VITE_PRC_PROXY_HOST=

# RPC proxy signing secret (required when using the RPC proxy)
VITE_RPC_SECRET_KEY=

# Solana RPC (Helius)
VITE_HELIUS_RPC_API_KEY=

# Alchemy RPC
VITE_ALCHEMY_RPC_API_KEY=

# TON RPC
VITE_TON_RPC_API_KEY=

# Minimum transfer amount (default: 0.0001)
VITE_TRANSFER_MIN_AMOUNT=0.0001

# Sentry DSN (optional)
VITE_SENTRY_DSN=

# Zendesk widget key (optional)
VITE_ZENDESK_KEY=
